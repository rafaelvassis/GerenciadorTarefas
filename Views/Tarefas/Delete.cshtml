@model GerenciadorTarefas.Models.Tarefa

@{
    ViewData["Title"] = "Excluir Tarefa";
}

<h1>Excluir Tarefa</h1>

<h3 class="text-danger">Tem certeza que deseja excluir esta tarefa?</h3>

<div>
    <h4>Detalhes da Tarefa</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Titulo)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Titulo)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Descricao)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.DataVencimento)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.DataVencimento)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-9">
            @Model.Status.String()
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.DataCriacao)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.DataCriacao)
        </dd>
    </dl>

    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="IdTarefa" />
        <input type="submit" value="Confirmar Exclusão" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar e Voltar</a>
    </form>
</div>
