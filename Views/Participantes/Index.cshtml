@model IEnumerable<GerenciadorTarefas.Models.Participante>

@{
    ViewData["Title"] = "Participantes";
}

<h1>Pessoas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nova Pessoa</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Tarefas</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Email</td>
                <td>
                    <a asp-controller="Tarefas" asp-action="Index" asp-route-participante="@item.IdParticipante">@item.Tarefas.Count</a>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdParticipante" class="btn btn-sm btn-warning">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdParticipante" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
