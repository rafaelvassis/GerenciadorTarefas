@model GerenciadorTarefas.Models.Categoria

@{
    ViewData["Title"] = "Excluir Categoria";
}

<h1>Excluir Categoria</h1>

<dl class="row mt-4">
    <dt class="col-sm-3">Nome</dt>
    <dd class="col-sm-9">@Model.Nome</dd>

    <dt class="col-sm-3">Tarefas</dt>
    <dd class="col-sm-9">@Model.Tarefas.Count</dd>
</dl>

@if (Model.Tarefas.Any())
{
    <div class="alert alert-warning">
        Esta categoria não pode ser excluída porque possui tarefas.
        Mude as tarefas para outra categoria ou exclua-as primeiro.
    </div>
    <a asp-action="Index" class="btn btn-secondary">Voltar para a Lista</a>
}
else
{
    <h3 class="text-danger">Tem certeza que deseja excluir esta categoria?</h3>

    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="IdCategoria" />
        <input type="submit" value="Confirmar Exclusão" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar e Voltar</a>
    </form>
}
